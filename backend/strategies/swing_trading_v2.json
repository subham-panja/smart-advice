{
  "name": "Swing_Trading_v2",
  "enabled": false,
  "description": "Full runner trend compounding with 200 SMA regime gate and market cap >= 2000 Cr",
  "analysis_config": {
    "technical_analysis": true,
    "fundamental_analysis": true,
    "sentiment_analysis": false,
    "sector_analysis": true,
    "market_regime_detection": true,
    "risk_management": true,
    "options_oi": true
  },
  "multitimeframe_execution": {
    "enabled": false,
    "lower_timeframe": "60m",
    "shortlist_top_n": 10
  },
  "analysis_weights": {
    "technical": 0.65,
    "fundamental": 0.2,
    "sentiment": 0.0,
    "sector": 0.15
  },
  "rs_config": {
    "period": 55,
    "threshold": 1.05
  },
  "market_regime_config": {
    "index": "^NSEI",
    "bull_market_rule": "sma(50) > sma(200) and latest close > sma(200)",
    "pause_buying_if_bearish": true
  },
  "options_oi_config": {
    "enabled": true,
    "weight": 0.15,
    "pcr_bullish_threshold": 1.0
  },
  "stock_filters": [
    {
      "type": "price",
      "op": "between",
      "min": 50.0,
      "max": 8000.0
    },
    {
      "type": "volume",
      "op": ">",
      "value": 250000
    },
    {
      "type": "market_cap",
      "op": ">",
      "value": 2500.0
    },
    {
      "type": "rsi",
      "op": "between",
      "period": 14,
      "min": 50,
      "max": 68
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 20,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 50,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 150,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 200,
      "op": ">",
      "target": "close"
    },
    {
      "type": "volume_spike_lookup",
      "lookback_days": 10,
      "multiplier": 1.2,
      "ma_period": 50
    }
  ],
  "recommendation_thresholds": {
    "buy_combined": 0.65,
    "technical_minimum": 0.45,
    "fundamental_minimum": 0.1,
    "min_risk_reward_ratio": 1.2,
    "backtest_period": "5y",
    "proximity_to_52_week_high_pct": 25.0
  },
  "strategy_config": {
    "RSI_Overbought_Oversold": {
      "enabled": true,
      "is_bonus": false,
      "rsi_period": 14,
      "overbought_level": 70,
      "oversold_level": 30
    },
    "MACD_Signal_Crossover": {
      "enabled": true,
      "is_bonus": true,
      "fast_period": 12,
      "slow_period": 26,
      "signal_period": 9,
      "check_divergence": false,
      "divergence_bars": 10,
      "block_on_bearish_divergence": false
    },
    "ADX_Trend_Strength": {
      "enabled": true,
      "is_bonus": false,
      "period": 14,
      "threshold": 20
    },
    "On_Balance_Volume": {
      "enabled": true,
      "is_bonus": true,
      "lookback_period": 20
    },
    "Bollinger_Band_Squeeze": {
      "enabled": true,
      "is_bonus": false,
      "period": 20,
      "std": 2,
      "squeeze_threshold": 0.95,
      "atr_multiplier": 1.5,
      "volatility_limit": 2.5
    },
    "Relative_Strength_Comparison": {
      "enabled": false,
      "is_bonus": true,
      "period": 55,
      "threshold": 0.0
    },
    "Pocket_Pivot_Entry": {
      "enabled": true,
      "is_bonus": true,
      "lookback": 10,
      "sma_fast": 10,
      "sma_slow": 50
    },
    "Volume_Breakout": {
      "enabled": true,
      "is_bonus": true,
      "period": 20,
      "threshold": 2.0,
      "regime_override": null
    },
    "Candlestick_Patterns": {
      "enabled": false,
      "is_bonus": true,
      "patterns": {
        "bullish_engulfing": true,
        "hammer": true,
        "morning_star": true
      }
    }
  },
  "swing_trading_gates": {
    "TREND_GATE": {
      "enabled": true,
      "params": {
        "adx_min": 20,
        "sma_period": 50,
        "require_price_above_sma": true,
        "require_sma_stack": false,
        "require_di_alignment": true
      }
    },
    "VOLATILITY_GATE": {
      "enabled": true,
      "params": {
        "max_percentile": 90,
        "lookback_days": 100,
        "min_percentile": 5
      }
    },
    "VOLUME_GATE": {
      "enabled": true,
      "params": {
        "min_volume_ratio": 0.4,
        "obv_trend_lookback": 10,
        "obv_required": false
      }
    },
    "MTF_GATE": {
      "enabled": false,
      "params": {
        "weekly_trend_check": true,
        "weekly_sma_fast": 10,
        "weekly_sma_slow": 30,
        "rsi_alignment_min": 45
      }
    }
  },
  "entry_patterns": [
    {
      "name": "pullback_to_ema",
      "enabled": true,
      "ema_period": 21,
      "rsi_range": [
        35,
        65
      ],
      "bullish_candle_required": true,
      "max_distance_pct": 2.0
    },
    {
      "name": "bollinger_squeeze_breakout",
      "enabled": true,
      "bb_period": 20,
      "bb_std": 2,
      "squeeze_threshold": 0.1,
      "retest_required": false,
      "max_squeeze_duration_days": 20
    },
    {
      "name": "macd_zero_cross",
      "enabled": false,
      "fast": 12,
      "slow": 26,
      "signal": 9,
      "above_zero_only": true,
      "require_histogram_expansion": true
    },
    {
      "name": "higher_low_structure",
      "enabled": true,
      "pivot_lookback": 7,
      "min_swings": 3,
      "require_volume_confirmation": true
    },
    {
      "name": "volatility_contraction",
      "enabled": true,
      "min_contractions": 3,
      "volume_dry_up_required": true,
      "max_atr_pct_of_price": 3.0
    },
    {
      "name": "twenty_day_high_breakout",
      "enabled": true,
      "volume_confirm": true,
      "min_volume_multiplier": 1.5,
      "retest_required": true,
      "max_distance_from_21ema_pct": 3.5
    },
    {
      "name": "nr7_volatility_squeeze",
      "enabled": true,
      "lookback": 7,
      "volume_dry_up": true
    }
  ],
  "exit_rules": {
    "targets": [
      {
        "name": "Target 1",
        "atr_multiplier": 2.2,
        "sell_percentage": 0.4
      },
      {
        "name": "Target 2",
        "atr_multiplier": 4.5,
        "sell_percentage": 1.0
      }
    ],
    "atr_stop_multiplier": 1.8,
    "trail_only_after_t1": false,
    "trail_min_gain_pct": 3.0,
    "trail_stop_atr": 1.8,
    "time_stop_bars": 15,
    "breakeven_at_target_1": true,
    "max_daily_loss_pct": null,
    "regime_adaptive_exits": {
      "bull": {
        "t1_sell_percentage": 0.25,
        "trail_stop_type": "atr",
        "trail_stop_atr_multiplier": 2.8,
        "trail_stop_ma_period": 20,
        "time_stop_bars": 15,
        "pyramiding_allowed": true,
        "oneil_target_pct": 25.0,
        "stop_loss_pct": 7.0
      },
      "bear": {
        "t1_sell_percentage": 0.5,
        "trail_stop_type": "ma",
        "trail_stop_atr_multiplier": 2.0,
        "trail_stop_ma_period": 10,
        "time_stop_bars": 8,
        "pyramiding_allowed": false,
        "oneil_target_pct": 15.0,
        "stop_loss_pct": 5.0
      }
    },
    "oneil_stop_loss_pct": 6.0,
    "leader_exception": {
      "enabled": true,
      "min_gain_pct": 20.0,
      "max_weeks": 8,
      "action": "hold_and_trail"
    },
    "hard_stop_loss_pct": 6.0
  },
  "risk_management": {
    "risk_per_trade_pct": 1.0,
    "max_risk_per_trade_pct": 1.5,
    "max_position_pct": 12.5,
    "max_positions": 8,
    "stop_loss_type": "ATR",
    "position_sizing": "risk_based",
    "volatility_scaling": {
      "enabled": true,
      "atr_lookback_days": 100,
      "low_volatility_percentile": 25,
      "high_volatility_percentile": 75,
      "min_risk_multiplier": 0.6
    },
    "drawdown_pause": {
      "enabled": true,
      "pause_threshold_pct": 12.0,
      "resume_threshold_pct": 7.0,
      "pause_days_min": 5,
      "cooldown_bars": 15
    },
    "max_sector_exposure_pct": 30.0
  },
  "pyramiding": {
    "enabled": false,
    "steps": [
      {
        "name": "First Add",
        "trigger_step_atr": 1.5,
        "add_size_pct": 0.4
      }
    ],
    "regime_controlled": false
  },
  "fundamental_config": {
    "min_roce": 18.0,
    "max_debt_to_equity": 1.0,
    "min_profit_growth_3y": 10.0,
    "min_profit_growth_5y": 10.0,
    "min_quarterly_eps_growth": 0.1
  },
  "rsi_momentum_filter": {
    "enabled": true,
    "min_rsi": 54,
    "require_rising": false
  },
  "market_breadth_filter": {
    "enabled": true,
    "sma_period": 20,
    "min_advance_pct": 35,
    "description": "Block new buys when <35% of stocks are above 20-SMA (broad market weakness)"
  }
}