{
  "name": "Swing_Trading_v2",
  "enabled": true,
  "description": "Institutional-grade swing trading system based on Mark Minervini's Stage 2 Trend Template. Uses strict price/SMA alignment, VCP/EMA Pullback entries, and ATR-based risk management.",
  "analysis_config": {
    "technical_analysis": true,
    "fundamental_analysis": false,
    "sentiment_analysis": false,
    "sector_analysis": true,
    "market_regime_detection": true,
    "risk_management": true,
    "options_oi": false
  },
  "multitimeframe_execution": {
    "enabled": true,
    "lower_timeframe": "60m",
    "shortlist_top_n": 5
  },
  "analysis_weights": {
    "technical": 0.80,
    "sector": 0.20,
    "fundamental": 0.0,
    "sentiment": 0.0
  },
  "market_regime_config": {
    "index": "^NSEI",
    "bull_market_rule": "latest close > sma(50)",
    "pause_buying_if_bearish": true,
    "min_adx": 18,
    "require_sma_slope_up": true,
    "sma_slope_lookback_bars": 5
  },
  "rs_config": {
    "period": 55,
    "threshold": 1.0
  },
  "options_oi_config": {
    "enabled": false,
    "weight": 0.15,
    "pcr_bullish_threshold": 1.0
  },
  "fundamental_gate": {
    "enabled": true,
    "description": "Used ONLY as a hard pre-filter to avoid junk stocks. Not used as a scored weight to override bad charts.",
    "min_roce": 15.0,
    "max_debt_to_equity": 1.5,
    "min_profit_growth_3y": 10.0
  },
  "recommendation_thresholds": {
    "buy_combined": 0.55,
    "technical_minimum": 0.45,
    "fundamental_minimum": 0.0,
    "min_risk_reward_ratio": 1.5,
    "backtest_period": "5y",
    "proximity_to_52_week_high_pct": 25.0
  },
  "strategy_config": {
    "RSI_Overbought_Oversold": {
      "enabled": true,
      "is_bonus": false,
      "rsi_period": 14,
      "overbought_level": 70,
      "oversold_level": 30
    },
    "MACD_Signal_Crossover": {
      "enabled": true,
      "is_bonus": true,
      "fast_period": 12,
      "slow_period": 26,
      "signal_period": 9,
      "check_divergence": false,
      "divergence_bars": 10,
      "block_on_bearish_divergence": false
    },
    "ADX_Trend_Strength": {
      "enabled": true,
      "is_bonus": false,
      "period": 14,
      "threshold": 20
    },
    "On_Balance_Volume": {
      "enabled": true,
      "is_bonus": true,
      "lookback_period": 20
    },
    "Bollinger_Band_Squeeze": {
      "enabled": true,
      "is_bonus": false,
      "period": 20,
      "std": 2,
      "squeeze_threshold": 0.95,
      "atr_multiplier": 1.5,
      "volatility_limit": 2.5
    },
    "Pocket_Pivot_Entry": {
      "enabled": true,
      "is_bonus": true,
      "lookback": 10,
      "sma_fast": 10,
      "sma_slow": 50
    },
    "Volume_Breakout": {
      "enabled": true,
      "is_bonus": true,
      "period": 20,
      "threshold": 1.4,
      "regime_override": null
    }
  },
  "swing_trading_gates": {
    "TREND_GATE": {
      "enabled": true,
      "params": {
        "adx_min": 20,
        "sma_period": 50,
        "require_price_above_sma": true,
        "require_sma_stack": false,
        "require_di_alignment": true
      }
    },
    "VOLATILITY_GATE": {
      "enabled": true,
      "params": {
        "max_percentile": 90,
        "lookback_days": 100,
        "min_percentile": 5
      }
    },
    "VOLUME_GATE": {
      "enabled": true,
      "params": {
        "min_volume_ratio": 0.4,
        "obv_trend_lookback": 10,
        "obv_required": false
      }
    },
    "MTF_GATE": {
      "enabled": true,
      "params": {
        "weekly_trend_check": true,
        "weekly_sma_fast": 10,
        "weekly_sma_slow": 30,
        "rsi_alignment_min": 45
      }
    }
  },
  "stock_filters": [
    {
      "type": "price",
      "op": "between",
      "min": 100.0,
      "max": 10000.0
    },
    {
      "type": "volume",
      "op": ">",
      "value": 150000
    },
    {
      "type": "market_cap",
      "op": ">",
      "value": 1000.0
    },
    {
      "type": "rsi",
      "op": "between",
      "period": 14,
      "min": 45,
      "max": 68
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 20,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 50,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 150,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 200,
      "op": ">",
      "target": "close"
    },
    {
      "type": "price_distance_sma",
      "period": 20,
      "op": "<=",
      "max_distance_pct": 5.0
    },
    {
      "type": "volume_spike_lookup",
      "lookback_days": 10,
      "multiplier": 1.2,
      "ma_period": 50
    }
  ],
  "entry_patterns": [
    {
      "name": "ema_21_pullback",
      "enabled": true,
      "ema_period": 21,
      "max_distance_pct": 2.0,
      "rsi_14_range": [
        45,
        60
      ],
      "bullish_reversal_candle": true
    },
    {
      "name": "minervini_vcp_breakout",
      "enabled": true,
      "consolidation_days_min": 10,
      "consolidation_days_max": 45,
      "volume_dry_up_required": true,
      "breakout_volume_multiplier": 1.5
    }
  ],
  "exit_rules": {
    "targets": [
      {
        "name": "Target 1 (Partial Profit)",
        "atr_multiplier": 2.5,
        "sell_percentage": 0.4
      },
      {
        "name": "Target 2",
        "atr_multiplier": 6.0,
        "sell_percentage": 1.0
      }
    ],
    "atr_stop_multiplier": 2.4,
    "hard_stop_loss_pct": 8.0,
    "trail_stop_atr": 2.2,
    "trail_stop_ma_period": 20,
    "breakeven_at_target_1": true,
    "time_stop_bars": 12,
    "max_daily_loss_pct": 1.5,
    "regime_adaptive_exits": {
      "bull": {
        "t1_sell_percentage": 0.35,
        "trail_stop_type": "atr",
        "trail_stop_atr_multiplier": 2.0,
        "trail_stop_ma_period": 20,
        "time_stop_bars": 15,
        "pyramiding_allowed": true,
        "oneil_target_pct": 20.0,
        "stop_loss_pct": 6.5
      },
      "bear": {
        "t1_sell_percentage": 0.5,
        "trail_stop_type": "ma",
        "trail_stop_atr_multiplier": 1.5,
        "trail_stop_ma_period": 10,
        "time_stop_bars": 8,
        "pyramiding_allowed": false,
        "oneil_target_pct": 12.0,
        "stop_loss_pct": 4.5
      }
    },
    "oneil_stop_loss_pct": 7.0,
    "leader_exception": {
      "enabled": true,
      "min_gain_pct": 20.0,
      "max_weeks": 8,
      "action": "hold_and_trail"
    }
  },
  "risk_management": {
    "risk_per_trade_pct": 2.0,
    "max_risk_per_trade_pct": 2.0,
    "max_position_pct": 30.0,
    "max_positions": 6,
    "stop_loss_type": "ATR",
    "position_sizing": "risk_based",
    "volatility_scaling": {
      "enabled": true,
      "atr_lookback_days": 100,
      "low_volatility_percentile": 25,
      "high_volatility_percentile": 75,
      "min_risk_multiplier": 0.6
    },
    "regime_adaptive_risk": {
      "bull": {
        "risk_per_trade_pct": 2.0,
        "max_positions": 6
      },
      "bear": {
        "risk_per_trade_pct": 1.0,
        "max_positions": 4
      }
    },
    "drawdown_pause": {
      "enabled": true,
      "pause_threshold_pct": 15.0,
      "resume_threshold_pct": 10.0,
      "pause_days_min": 5
    }
  },
  "pyramiding": {
    "enabled": true,
    "steps": [
      {
        "name": "First Add",
        "trigger_step_atr": 1.5,
        "add_size_pct": 0.5
      },
      {
        "name": "Second Add",
        "trigger_step_atr": 3.0,
        "add_size_pct": 0.3
      }
    ],
    "regime_controlled": true
  },
  "fundamental_config": {
    "min_roce": 15.0,
    "max_debt_to_equity": 1.5,
    "min_profit_growth_3y": 10.0,
    "min_profit_growth_5y": 10.0,
    "min_quarterly_eps_growth": 0.1
  }
}