{
  "name": "Swing_Trading_v2",
  "enabled": true,
  "description": "Institutional-grade swing trading system based on Mark Minervini's Stage 2 Trend Template. Uses strict price/SMA alignment, VCP/EMA Pullback entries, and ATR-based risk management.",
  "analysis_config": {
    "technical_analysis": true,
    "fundamental_analysis": false,
    "sentiment_analysis": false,
    "sector_analysis": true,
    "market_regime_detection": true,
    "risk_management": true,
    "options_oi": false
  },
  "multitimeframe_execution": {
    "enabled": false,
    "lower_timeframe": "60m",
    "shortlist_top_n": 5
  },
  "analysis_weights": {
    "technical": 0.85,
    "sector": 0.15,
    "fundamental": 0.0,
    "sentiment": 0.0
  },
  "market_regime_config": {
    "index": "^NSEI",
    "bull_market_rule": "latest close > sma(200)",
    "pause_buying_if_bearish": false,
    "min_adx": 15,
    "require_sma_slope_up": false,
    "sma_slope_lookback_bars": 5
  },
  "rs_config": {
    "period": 55,
    "threshold": 1.05
  },
  "options_oi_config": {
    "enabled": false,
    "weight": 0.15,
    "pcr_bullish_threshold": 1.0
  },
  "fundamental_gate": {
    "enabled": false,
    "description": "Used ONLY as a hard pre-filter to avoid junk stocks. Not used as a scored weight to override bad charts.",
    "min_roce": 15.0,
    "max_debt_to_equity": 1.5,
    "min_profit_growth_3y": 10.0
  },
  "recommendation_thresholds": {
    "buy_combined": 0.50,
    "technical_minimum": 0.40,
    "fundamental_minimum": 0.0,
    "min_risk_reward_ratio": 1.1,
    "backtest_period": "5y",
    "proximity_to_52_week_high_pct": 30.0
  },
  "strategy_config": {
    "RSI_Overbought_Oversold": {
      "enabled": true,
      "is_bonus": false,
      "rsi_period": 14,
      "overbought_level": 75,
      "oversold_level": 40
    },
    "MACD_Signal_Crossover": {
      "enabled": true,
      "is_bonus": true,
      "fast_period": 12,
      "slow_period": 26,
      "signal_period": 9,
      "check_divergence": false,
      "divergence_bars": 10,
      "block_on_bearish_divergence": false
    },
    "ADX_Trend_Strength": {
      "enabled": true,
      "is_bonus": false,
      "period": 14,
      "threshold": 20
    },
    "On_Balance_Volume": {
      "enabled": true,
      "is_bonus": true,
      "lookback_period": 20
    },
    "Bollinger_Band_Squeeze": {
      "enabled": false,
      "is_bonus": true,
      "period": 20,
      "std": 2,
      "squeeze_threshold": 0.95,
      "atr_multiplier": 1.5,
      "volatility_limit": 2.5
    },
    "Pocket_Pivot_Entry": {
      "enabled": true,
      "is_bonus": true,
      "lookback": 10,
      "sma_fast": 10,
      "sma_slow": 50
    },
    "Volume_Breakout": {
      "enabled": true,
      "is_bonus": true,
      "period": 20,
      "threshold": 1.2,
      "regime_override": null
    }
  },
  "swing_trading_gates": {
    "TREND_GATE": {
      "enabled": true,
      "params": {
        "adx_min": 18,
        "sma_period": 50,
        "require_price_above_sma": true,
        "require_sma_stack": false,
        "require_di_alignment": false
      }
    },
    "VOLATILITY_GATE": {
      "enabled": true,
      "params": {
        "lookback_days": 100,
        "min_percentile": 5,
        "max_percentile": 95
      }
    },
    "VOLUME_GATE": {
      "enabled": true,
      "params": {
        "min_volume_ratio": 0.5,
        "obv_trend_lookback": 10,
        "obv_required": false
      }
    },
    "MTF_GATE": {
      "enabled": false,
      "params": {
        "weekly_trend_check": true,
        "weekly_sma_fast": 10,
        "weekly_sma_slow": 30,
        "rsi_alignment_min": 45
      }
    }
  },
  "stock_filters": [
    {
      "type": "price",
      "op": "between",
      "min": 50.0,
      "max": 25000.0
    },
    {
      "type": "volume",
      "op": ">",
      "value": 100000
    },
    {
      "type": "market_cap",
      "op": ">",
      "value": 500.0
    },
    {
      "type": "rsi",
      "op": "between",
      "period": 14,
      "min": 45,
      "max": 78
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 50,
      "op": ">",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 200,
      "op": ">",
      "target": "close"
    }
  ],
  "entry_patterns": [
    {
      "name": "ema_21_pullback",
      "enabled": true,
      "ema_period": 21,
      "max_distance_pct": 3.0,
      "rsi_14_range": [
        45,
        70
      ],
      "bullish_reversal_candle": true
    },
    {
      "name": "minervini_vcp_breakout",
      "enabled": true,
      "consolidation_days_min": 10,
      "consolidation_days_max": 45,
      "volume_dry_up_required": true,
      "breakout_volume_multiplier": 1.3
    }
  ],
  "exit_rules": {
    "targets": [
      {
        "name": "Target 1",
        "atr_multiplier": 2.2,
        "sell_percentage": 0.50
      },
      {
        "name": "Target 2",
        "atr_multiplier": 5.0,
        "sell_percentage": 1.0
      }
    ],
    "atr_stop_multiplier": 1.2,
    "hard_stop_loss_pct": 4.5,
    "trail_only_after_t1": true,
    "trail_min_gain_pct": 3.0,
    "trail_stop_atr": 1.5,
    "trail_stop_ma_period": 20,
    "breakeven_at_target_1": true,
    "time_stop_bars": 20,
    "max_daily_loss_pct": 5.0,
    "regime_adaptive_exits": {},
    "oneil_stop_loss_pct": 5.0,
    "leader_exception": {
      "enabled": true,
      "min_gain_pct": 20.0,
      "max_weeks": 8,
      "action": "hold_and_trail"
    }
  },
  "risk_management": {
    "risk_per_trade_pct": 4.0,
    "max_risk_per_trade_pct": 4.0,
    "max_position_pct": 33.0,
    "max_portfolio_risk_pct": 15.0,
    "max_positions": 3,
    "max_sector_exposure_pct": 35.0,
    "position_sizing": "risk_based",
    "stop_loss_type": "ATR",
    "volatility_scaling": {
      "enabled": true,
      "target_atr_pct": 2.5,
      "min_scale": 0.6,
      "max_scale": 1.4
    },
    "drawdown_pause": {
      "enabled": true,
      "max_drawdown_pct": 15.0,
      "resume_drawdown_pct": 10.0,
      "pause_after_consecutive_losses": 4
    }
  },
  "pyramiding": {
    "enabled": true,
    "profit_threshold_pct": 4.0,
    "pyramid_size_pct": 35.0,
    "max_pyramid_steps": 1,
    "move_stop_to_entry": true,
    "regime_controlled": false
  },
  "fundamental_config": {
    "min_roce": 15.0,
    "max_debt_to_equity": 1.5,
    "min_profit_growth_3y": 10.0,
    "min_profit_growth_5y": 10.0,
    "min_quarterly_eps_growth": 0.1
  }
}