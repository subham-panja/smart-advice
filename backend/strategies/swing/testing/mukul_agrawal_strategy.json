{
  "name": "Mukul_Agrawal_Strategy",
  "enabled": true,
  "description": "Mukul Agrawal (Param Capital) Techno-Fundamental Multi-Year Base Breakout Strategy. Targets high multi-bagger upside in high-growth small/mid-caps crossing 52-week or multi-year highs on massive volume expansion with controlled drawdown risk.",
  "analysis_config": {
    "technical_analysis": true,
    "fundamental_analysis": true,
    "sentiment_analysis": false,
    "sector_analysis": true,
    "market_regime_detection": true,
    "risk_management": true,
    "options_oi": false
  },
  "analysis_weights": {
    "technical": 0.70,
    "fundamental": 0.15,
    "sentiment": 0.0,
    "sector": 0.15
  },
  "rs_config": {
    "period": 55,
    "threshold": 1.0
  },
  "market_regime_config": {
    "index": "^NSEI",
    "bull_market_rule": "sma(200)",
    "pause_buying_if_bearish": true
  },
  "stock_filters": [
    {
      "type": "price",
      "op": "between",
      "min": 50.0,
      "max": 15000.0
    },
    {
      "type": "volume",
      "op": ">",
      "value": 40000
    },
    {
      "type": "market_cap",
      "op": ">",
      "value": 600.0
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 50,
      "op": ">",
      "target": "close"
    }
  ],
  "recommendation_thresholds": {
    "buy_combined": 0.50,
    "technical_minimum": 0.35,
    "fundamental_minimum": 0.1,
    "min_risk_reward_ratio": 1.8,
    "backtest_period": "5y",
    "proximity_to_52_week_high_pct": 15.0
  },
  "strategy_config": {
    "RSI_Overbought_Oversold": {
      "enabled": true,
      "is_bonus": true,
      "rsi_period": 14,
      "overbought_level": 75,
      "oversold_level": 30
    },
    "MACD_Signal_Crossover": {
      "enabled": true,
      "is_bonus": true,
      "fast_period": 12,
      "slow_period": 26,
      "signal_period": 9
    },
    "ADX_Trend_Strength": {
      "enabled": true,
      "is_bonus": true,
      "period": 14,
      "threshold": 18
    },
    "Volume_Breakout": {
      "enabled": true,
      "is_bonus": false,
      "period": 20,
      "threshold": 1.8
    },
    "Relative_Strength_Comparison": {
      "enabled": true,
      "is_bonus": true,
      "period": 55,
      "threshold": 0.0
    }
  },
  "swing_trading_gates": {
    "TREND_GATE": {
      "enabled": true,
      "params": {
        "adx_min": 16,
        "sma_period": 50,
        "require_price_above_sma": true,
        "require_sma_stack": false,
        "require_di_alignment": true
      }
    },
    "VOLATILITY_GATE": {
      "enabled": true,
      "params": {
        "max_percentile": 92,
        "lookback_days": 100,
        "min_percentile": 5
      }
    },
    "VOLUME_GATE": {
      "enabled": true,
      "params": {
        "min_volume_ratio": 1.4,
        "obv_trend_lookback": 15,
        "obv_required": true
      }
    }
  },
  "entry_patterns": [
    {
      "name": "twenty_day_high_breakout",
      "enabled": true,
      "volume_confirm": true,
      "min_volume_multiplier": 1.8,
      "retest_required": false,
      "max_distance_from_21ema_pct": 8.5
    },
    {
      "name": "minervini_vcp_breakout",
      "enabled": true,
      "consolidation_days_min": 10,
      "consolidation_days_max": 50,
      "breakout_volume_multiplier": 1.5,
      "volume_dry_up_required": true
    },
    {
      "name": "higher_low_structure",
      "enabled": true,
      "pivot_lookback": 8,
      "min_swings": 3,
      "require_volume_confirmation": true
    }
  ],
  "exit_rules": {
    "targets": [
      {
        "name": "Target 1",
        "atr_multiplier": 3.0,
        "sell_percentage": 0.25
      },
      {
        "name": "Target 2",
        "atr_multiplier": 7.0,
        "sell_percentage": 0.25
      }
    ],
    "atr_stop_multiplier": 2.0,
    "trail_only_after_t1": false,
    "trail_min_gain_pct": 4.0,
    "trail_stop_atr": 2.6,
    "time_stop_bars": 50,
    "breakeven_at_target_1": true,
    "hard_stop_loss_pct": 7.0
  },
  "risk_management": {
    "risk_per_trade_pct": 1.8,
    "max_risk_per_trade_pct": 2.0,
    "max_position_pct": 20.0,
    "max_positions": 5,
    "regime_adaptive_risk": {
      "bull": {
        "max_positions": 5,
        "max_position_pct": 20.0,
        "risk_per_trade_pct": 1.8
      },
      "sideways": {
        "max_positions": 3,
        "max_position_pct": 14.0,
        "risk_per_trade_pct": 1.0
      },
      "bear": {
        "max_positions": 0,
        "max_position_pct": 0.0,
        "risk_per_trade_pct": 0.0
      }
    },
    "stop_loss_type": "ATR",
    "position_sizing": "risk_based"
  },
  "pyramiding": {
    "enabled": true,
    "steps": [
      {
        "name": "First Add",
        "trigger_step_atr": 2.0,
        "add_size_pct": 0.30
      }
    ],
    "regime_controlled": true,
    "max_position_multiplier": 1.3
  },
  "fundamental_config": {
    "min_roce": 12.0,
    "max_debt_to_equity": 1.5,
    "min_profit_growth_3y": 10.0,
    "min_profit_growth_5y": 0.0,
    "min_quarterly_eps_growth": 0.05
  },
  "market_breadth_filter": {
    "enabled": true,
    "sma_period": 20,
    "min_advance_pct": 36.0
  }
}
