{
  "name": "Kunal_Saraogi_Strategy",
  "enabled": true,
  "description": "Kunal Saraogi (Equityrush) Dual Momentum Matrix Strategy. Requires absolute momentum (Close > 50 SMA > 200 SMA, trading near 52W high) and relative momentum outperforming Nifty 500, with mechanical 20-EMA / ATR trailing stops.",
  "analysis_config": {
    "technical_analysis": true,
    "fundamental_analysis": false,
    "sentiment_analysis": false,
    "sector_analysis": true,
    "market_regime_detection": true,
    "risk_management": true,
    "options_oi": false
  },
  "analysis_weights": {
    "technical": 0.85,
    "fundamental": 0.0,
    "sentiment": 0.0,
    "sector": 0.15
  },
  "rs_config": {
    "period": 55,
    "threshold": 1.0
  },
  "market_regime_config": {
    "index": "^NSEI",
    "bull_market_rule": "sma(200)",
    "pause_buying_if_bearish": true
  },
  "stock_filters": [
    {
      "type": "price",
      "op": "between",
      "min": 50.0,
      "max": 15000.0
    },
    {
      "type": "volume",
      "op": ">",
      "value": 50000
    },
    {
      "type": "market_cap",
      "op": ">",
      "value": 1500.0
    },
    {
      "type": "moving_average",
      "kind": "SMA",
      "period": 50,
      "op": ">",
      "target": "close"
    }
  ],
  "recommendation_thresholds": {
    "buy_combined": 0.50,
    "technical_minimum": 0.35,
    "fundamental_minimum": 0.0,
    "min_risk_reward_ratio": 1.6,
    "backtest_period": "5y",
    "proximity_to_52_week_high_pct": 15.0
  },
  "strategy_config": {
    "RSI_Overbought_Oversold": {
      "enabled": true,
      "is_bonus": true,
      "rsi_period": 14,
      "overbought_level": 70,
      "oversold_level": 35
    },
    "MACD_Signal_Crossover": {
      "enabled": true,
      "is_bonus": true,
      "fast_period": 12,
      "slow_period": 26,
      "signal_period": 9
    },
    "ADX_Trend_Strength": {
      "enabled": true,
      "is_bonus": true,
      "period": 14,
      "threshold": 18
    },
    "Relative_Strength_Comparison": {
      "enabled": true,
      "is_bonus": false,
      "period": 55,
      "threshold": 0.0
    }
  },
  "swing_trading_gates": {
    "TREND_GATE": {
      "enabled": true,
      "params": {
        "adx_min": 18,
        "sma_period": 50,
        "require_price_above_sma": true,
        "require_sma_stack": false,
        "require_di_alignment": true
      }
    },
    "VOLATILITY_GATE": {
      "enabled": true,
      "params": {
        "max_percentile": 90,
        "lookback_days": 100,
        "min_percentile": 5
      }
    },
    "VOLUME_GATE": {
      "enabled": true,
      "params": {
        "min_volume_ratio": 1.2,
        "obv_trend_lookback": 12,
        "obv_required": true
      }
    }
  },
  "rsi_momentum_filter": {
    "enabled": true,
    "min_rsi": 52,
    "require_rising": true
  },
  "entry_patterns": [
    {
      "name": "twenty_day_high_breakout",
      "enabled": true,
      "volume_confirm": true,
      "min_volume_multiplier": 1.3,
      "retest_required": false,
      "max_distance_from_21ema_pct": 6.5
    },
    {
      "name": "pullback_to_ema",
      "enabled": true,
      "ema_period": 21,
      "max_distance_pct": 2.5,
      "rsi_14_range": [42, 65],
      "bullish_candle_required": true
    },
    {
      "name": "higher_low_structure",
      "enabled": true,
      "pivot_lookback": 8,
      "min_swings": 3,
      "require_volume_confirmation": false
    }
  ],
  "exit_rules": {
    "targets": [
      {
        "name": "Target 1",
        "atr_multiplier": 2.5,
        "sell_percentage": 0.30
      },
      {
        "name": "Target 2",
        "atr_multiplier": 5.5,
        "sell_percentage": 0.30
      }
    ],
    "atr_stop_multiplier": 1.9,
    "trail_only_after_t1": false,
    "trail_min_gain_pct": 3.5,
    "trail_stop_atr": 2.2,
    "time_stop_bars": 40,
    "breakeven_at_target_1": true,
    "hard_stop_loss_pct": 6.5
  },
  "risk_management": {
    "risk_per_trade_pct": 1.6,
    "max_risk_per_trade_pct": 2.0,
    "max_position_pct": 20.0,
    "max_positions": 5,
    "regime_adaptive_risk": {
      "bull": {
        "max_positions": 5,
        "max_position_pct": 20.0,
        "risk_per_trade_pct": 1.6
      },
      "sideways": {
        "max_positions": 3,
        "max_position_pct": 15.0,
        "risk_per_trade_pct": 1.0
      },
      "bear": {
        "max_positions": 0,
        "max_position_pct": 0.0,
        "risk_per_trade_pct": 0.0
      }
    },
    "stop_loss_type": "ATR",
    "position_sizing": "risk_based"
  },
  "pyramiding": {
    "enabled": false
  },
  "market_breadth_filter": {
    "enabled": true,
    "sma_period": 20,
    "min_advance_pct": 35.0
  }
}

