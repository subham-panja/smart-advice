{
  "name": "Nitin_Triple_Confirm_Retracement",
  "enabled": false,
  "analysis_config": {
    "technical_analysis": true,
    "fundamental_analysis": true,
    "sentiment_analysis": false,
    "sector_analysis": true,
    "market_regime_detection": true,
    "individual_stock_backtest": false,
    "options_oi": false
  },
  "analysis_weights": {
    "technical": 0.8,
    "fundamental": 0.1,
    "sector": 0.1,
    "sentiment": 0.0
  },
  "rs_config": {
    "period": 55,
    "threshold": 0.5
  },
  "market_regime_config": {
    "index": "^NSEI",
    "bull_market_rule": "latest close > sma(200)"
  },
  "stock_filters": [
    {
      "type": "price",
      "op": "between",
      "min": 50.0,
      "max": 8000.0
    },
    {
      "type": "volume",
      "op": ">",
      "value": 100000
    },
    {
      "type": "market_cap",
      "op": ">",
      "value": 5000.0
    },
    {
      "type": "moving_average",
      "kind": "HMA",
      "period": 30,
      "op": "monitor",
      "target": "close"
    },
    {
      "type": "moving_average",
      "kind": "HMA",
      "period": 44,
      "op": "monitor",
      "target": "close"
    }
  ],
  "recommendation_thresholds": {
    "buy_combined": 0.3,
    "technical_minimum": 0.25,
    "fundamental_minimum": 0.05,
    "min_risk_reward_ratio": 2.0,
    "min_backtest_return": -10.0,
    "backtest_period": "2y",
    "min_data_required_days": 400
  },
  "strategy_config": {
    "RSI_Overbought_Oversold": {
      "enabled": false
    },
    "MACD_Signal_Crossover": {
      "enabled": true,
      "is_bonus": true,
      "fast_period": 21,
      "slow_period": 39,
      "signal_period": 9,
      "min_histogram_bars_below_zero": 8,
      "require_first_green_histogram": true,
      "check_divergence": false
    },
    "RSI_Strength_Cross": {
      "enabled": true,
      "is_bonus": true,
      "rsi_period": 9,
      "fast_ma_period": 3,
      "slow_wma_period": 21,
      "require_cross_above": true
    },
    "ADX_Trend_Strength": {
      "enabled": true,
      "is_bonus": true,
      "period": 14,
      "threshold": 20
    },
    "Bollinger_Band_Squeeze": {
      "enabled": false
    },
    "Pocket_Pivot_Entry": {
      "enabled": false
    },
    "Volume_Breakout": {
      "enabled": false
    }
  },
  "swing_trading_gates": {
    "TREND_GATE": {
      "enabled": true,
      "params": {
        "adx_min": 20,
        "require_di_alignment": false,
        "require_price_above_sma": false
      }
    },
    "VOLATILITY_GATE": {
      "enabled": false
    },
    "VOLUME_GATE": {
      "enabled": false
    },
    "MTF_GATE": {
      "enabled": false
    }
  },
  "entry_patterns": [
    {
      "name": "triple_confirm_hma_retracement",
      "enabled": true,
      "hma_fast": 30,
      "hma_slow": 44,
      "price_zone_requirement": "between_or_above_hma",
      "macd_confirmed": true,
      "rsi_wma_confirmed": false
    }
  ],
  "rsi_momentum_filter": {
    "min_rsi": 45,
    "require_rising": true
  },
  "exit_rules": {
    "_priority_note": "Target is the previous major swing high. Stop loss is the previous swing low. Strategy heavily relies on active daily rebalancing.",
    "targets": [
      {
        "name": "Swing High (Partial)",
        "type": "swing_structure",
        "sell_percentage": 0.5
      },
      {
        "name": "ATR Runner",
        "atr_multiplier": 5.0,
        "sell_percentage": 1.0
      }
    ],
    "stop_loss_type": "swing_low",
    "atr_stop_multiplier": 2.0,
    "trail_stop_atr": 2.0,
    "time_stop_bars": 40,
    "breakeven_at_target_1": true,
    "max_daily_loss_pct": 5.0,
    "daily_active_rebalancing": {
      "enabled": true,
      "top_gainer_threshold_pct": 5.0,
      "sell_amount_of_remaining_position_pct": 20.0,
      "bottom_loser_threshold_pct": -5.0,
      "buy_amount_with_freed_capital_pct": 0.0
    },
    "regime_adaptive_exits": {
      "bull": {
        "t1_sell_percentage": 0.5,
        "trail_stop_type": "atr",
        "trail_stop_atr_multiplier": 2.5,
        "trail_stop_ma_period": 20,
        "time_stop_bars": 40,
        "pyramiding_allowed": true,
        "oneil_target_pct": 30.0,
        "stop_loss_pct": 8.0
      },
      "bear": {
        "t1_sell_percentage": 1.0,
        "trail_stop_type": "ma",
        "trail_stop_atr_multiplier": 1.0,
        "trail_stop_ma_period": 10,
        "time_stop_bars": 10,
        "pyramiding_allowed": false,
        "oneil_target_pct": 12.0,
        "stop_loss_pct": 5.0
      }
    },
    "leader_exception": {
      "enabled": true,
      "min_gain_pct": 20.0,
      "max_weeks": 8,
      "action": "hold_and_trail"
    }
  },
  "risk_management": {
    "risk_per_trade_pct": 1.0,
    "max_risk_per_trade_pct": 1.5,
    "max_position_pct": 8.0,
    "max_positions": 8,
    "stop_loss_type": "swing_low",
    "position_sizing": "risk_based",
    "volatility_scaling": {
      "enabled": true,
      "atr_lookback_days": 100,
      "low_volatility_percentile": 25,
      "high_volatility_percentile": 75,
      "min_risk_multiplier": 0.5
    },
    "regime_adaptive_risk": {
      "bull": {
        "risk_per_trade_pct": 1.0,
        "max_positions": 8,
        "stop_loss_pct": 8.0
      },
      "bear": {
        "risk_per_trade_pct": 0.5,
        "max_positions": 3,
        "stop_loss_pct": 5.0
      }
    }
  },
  "pyramiding": {
    "enabled": true,
    "steps": [
      {
        "name": "Buy The Dip Rebalancing",
        "trigger_daily_drop_pct": 3.0,
        "add_size_from_cash_pool_pct": 10.0
      }
    ],
    "regime_controlled": true
  },
  "fundamental_config": {
    "min_roce": 15.0,
    "max_debt_to_equity": 1.0,
    "min_profit_growth_3y": 10.0
  }
}