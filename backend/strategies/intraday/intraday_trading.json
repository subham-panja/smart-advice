{
  "name": "Intraday_Trading_v1",
  "enabled": true,
  "description": "Institutional 1-Hour chart multi-confluence intraday system utilizing 1h ORB, daily-anchored VWAP, and CPR on liquid NSE equities with automated EOD 15:15 IST square-off and zero overnight holding.",
  "timeframe_config": {
    "macro_timeframe": "1h",
    "chart_timeframe": "1h",
    "execution_timeframe": "1h",
    "market_open_time": "09:15",
    "trading_start_time": "10:15",
    "no_new_entries_time": "14:15",
    "auto_square_off_time": "15:15",
    "market_close_time": "15:30"
  },
  "vectorbt_backtest": {
    "enabled": true,
    "timeframe": "1h",
    "freq": "1h",
    "benchmark": "^NSEI",
    "initial_capital": 100000.0,
    "max_positions": 3,
    "risk_per_trade_pct": 1.0,
    "commission_pct": 0.0005,
    "slippage_pct": 0.0005,
    "default_period": "730d",
    "enforce_eod_square_off": true,
    "eod_square_off_hour": 15
  },
  "stock_universe_filters": [
    {
      "type": "volume",
      "op": ">=",
      "value": 500000,
      "description": "High liquidity only (average 500k daily volume to eliminate slippage)"
    },
    {
      "type": "market_cap",
      "op": ">=",
      "value": 5000.0,
      "description": "NSE 200 large/mid-cap equities"
    },
    {
      "type": "price",
      "op": "between",
      "min": 100.0,
      "max": 10000.0
    },
    {
      "type": "atr_pct",
      "op": ">=",
      "value": 1.2,
      "description": "Minimum daily ATR of 1.2% to ensure adequate intraday movement"
    }
  ],
  "intraday_gates": {
    "MARKET_HOURS_GATE": {
      "enabled": true,
      "params": {
        "allow_entries_after": "10:15",
        "block_entries_after": "14:15",
        "observe_opening_range_mins": 60
      }
    },
    "CPR_GATE": {
      "enabled": true,
      "params": {
        "require_cpr_alignment": true,
        "narrow_cpr_threshold_pct": 0.5,
        "skip_trading_if_super_wide_cpr": true
      }
    },
    "VWAP_GATE": {
      "enabled": true,
      "params": {
        "require_price_above_vwap_for_long": true,
        "require_price_below_vwap_for_short": false,
        "max_distance_from_vwap_pct": 1.5
      }
    },
    "VOLATILITY_GATE": {
      "enabled": true,
      "params": {
        "min_1h_atr": 1.0,
        "max_1h_atr_pct": 3.0
      }
    }
  },
  "entry_patterns": [
    {
      "name": "orb_1h_breakout",
      "enabled": true,
      "opening_range_minutes": 60,
      "candle_close_confirmation": true,
      "volume_surge_multiplier": 1.2,
      "require_vwap_support": true
    },
    {
      "name": "vwap_pullback_rejection",
      "enabled": true,
      "max_distance_from_vwap_pct": 0.5,
      "reversal_candle_types": [
        "hammer",
        "bullish_engulfing",
        "pin_bar"
      ]
    },
    {
      "name": "cpr_breakout_and_retest",
      "enabled": true,
      "breakout_pivot": "TC",
      "retest_confirmation_required": true
    }
  ],
  "exit_rules": {
    "stop_loss_type": "ATR_OR_PIVOT",
    "atr_stop_multiplier": 1.2,
    "max_stop_loss_pct": 1.5,
    "target_1_multiplier": 1.8,
    "target_1_sell_pct": 0.50,
    "target_2_multiplier": 3.0,
    "breakeven_at_target_1": true,
    "trail_stop_vwap": true,
    "time_exit": {
      "mandatory_square_off": "15:15",
      "order_type": "MARKET"
    }
  },
  "risk_management": {
    "max_positions": 3,
    "capital_allocation_pct": 30.0,
    "risk_per_trade_pct": 1.0,
    "max_daily_loss_pct": 2.0,
    "max_consecutive_losses": 2,
    "pause_trading_after_two_losses": true
  },
  "_file_name": "intraday_trading.json"
}
